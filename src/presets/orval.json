{
  "patterns": {
    "namespace": "orval",
    "accessStyle": "member",
    "depth": { "member": 1, "operation": 2 },
    "hooks": [
      {
        "name": "useQuery",
        "argIndex": 0,
        "argStyle": "object-property-identifier",
        "objectProperty": "queryFn"
      },
      {
        "name": "useMutation",
        "argIndex": 0,
        "argStyle": "object-property-identifier",
        "objectProperty": "mutationFn"
      },
      {
        "name": "useInfiniteQuery",
        "argIndex": 0,
        "argStyle": "object-property-identifier",
        "objectProperty": "queryFn"
      },
      {
        "name": "useSuspenseQuery",
        "argIndex": 0,
        "argStyle": "object-property-identifier",
        "objectProperty": "queryFn"
      }
    ]
  },
  "packageStructure": {
    "layout": "flat",
    "memberDir": "endpoints",
    "naming": "kebab-case",
    "extensions": [".js", ".d.ts", ".ts"],
    "preserve": ["index.js", "index.d.ts", "index.ts", "package.json"]
  }
}
