{
  "patterns": {
    "namespace": "trpc",
    "accessStyle": "member",
    "depth": { "member": 1, "operation": 2 },
    "hooks": [
      { "name": "useQuery", "argIndex": 0, "argStyle": "namespace-member-member" },
      { "name": "useMutation", "argIndex": 0, "argStyle": "namespace-member-member" }
    ]
  },
  "packageStructure": {
    "layout": "flat",
    "memberDir": "routers",
    "naming": "camelCase",
    "extensions": [".js", ".d.ts"],
    "preserve": ["index.js", "index.d.ts", "package.json"]
  }
}
