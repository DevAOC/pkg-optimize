{
  "name": "pkg-optimize",
  "version": "0.3.0",
  "description": "Prunes unused models from symlinked @gadget-client/* packages in Gadget apps by scanning web/ and extensions/ for api.* and hook usage.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevAOC/pkg-optimize"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "pkg-optimize": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:experimental": "node --experimental-strip-types scripts/publish-experimental.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "gadget",
    "tree-shaking",
    "pruning",
    "node-modules",
    "bundle-size",
    "gadget-client",
    "shopify"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "chokidar": "^3.6.0",
    "debug": "^4.4.3",
    "lodash.debounce": "^4.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/debug": "^4.1.13",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  }
}
